{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(yt-dlp *)",
      "Bash(mkdir *)",
      "mcp__claude_ai_Apify__get-dataset-items",
      "mcp__claude_ai_Apify__search-actors",
      "mcp__claude_ai_Apify__fetch-actor-details"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cmd //c \"automation\\session_start.bat\"",
            "timeout": 30,
            "statusMessage": "artflow 모루 + morus-shared-memory sync"
          }
        ]
      }
    ]
  }
}
